generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  RECRUITER
  INTERVIEWER
  HIRING_MANAGER
}

enum PositionStatus {
  OPEN
  ON_HOLD
  CLOSED
  FILLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Seniority {
  JUNIOR
  MID
  SENIOR
  STAFF
  PRINCIPAL
}

enum Stage {
  APPLIED
  SCREENING
  TECHNICAL_INTERVIEW
  MANAGER_INTERVIEW
  CLIENT_INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum SchedulingMode {
  MANUAL_SLOTS
  CALENDAR_LINK
}

enum CompensationRisk {
  LOW
  MEDIUM
  HIGH
}

enum SourceType {
  RECRUITER
  VENDOR
  OTHER
}

enum PipelineStage {
  APPLIED
  SCREENING
  TECHNICAL_INTERVIEW
  MANAGER_INTERVIEW
  CLIENT_INTERVIEW
  OFFER
  HIRED
  REJECTED
}

enum InterviewStatus {
  PENDING
  AWAITING_SCHEDULE
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum InterviewDecision {
  ADVANCE
  REJECT
  HOLD
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String?
  role         Role     @default(RECRUITER)
  image        String?
  calendarLink               String?
  timezone                   String?  @default("America/Montevideo")
  schedulingEmailTemplate    String?  @db.Text
  rejectionEmailTemplate     String?  @db.Text
  advanceEmailTemplate       String?  @db.Text
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  accounts Account[]
  sessions Session[]

  positionsAsRecruiter  Position[]          @relation("RecruiterPositions")
  candidatePositions    CandidatePosition[] @relation("RecruiterCandidatePositions")
  stageHistoryMoves     StageHistory[]
  sourcedCandidates     Candidate[]         @relation("CandidateSourcedByUser")
  decidedInterviews     Interview[]         @relation("InterviewDecidedBy")
  emailLogs             EmailLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Vendor {
  id        String   @id @default(cuid())
  name      String
  pocName   String?
  pocEmail  String?
  phone     String?
  notes     String?  @db.Text
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  candidates Candidate[]
}

model Position {
  id                   String         @id @default(cuid())
  title                String
  client               String
  description          String         @db.Text
  status               PositionStatus @default(OPEN)
  priority             Priority       @default(MEDIUM)
  target_date_asap     Boolean        @default(false)
  target_date          DateTime?
  location             String[]
  recruiterId          String
  hiring_manager_name  String?
  hiring_manager_email String?
  sales_contact_email  String?
  clientRate          Float?
  internalCostBudget  Float?
  dgm                 Float?
  dgmAtRisk           Boolean @default(false)
  jdParsed             Boolean    @default(false)
  jdSkills             String[]
  jdSeniority          Seniority?
  jdLanguages          String[]
  jdSummary            String?    @db.Text
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  deletedAt            DateTime?

  recruiter          User                @relation("RecruiterPositions", fields: [recruiterId], references: [id])
  candidatePositions CandidatePosition[]
}

model Candidate {
  id                    String      @id @default(cuid())
  firstName             String
  lastName              String
  email                 String      @unique
  phone                 String?
  country               String?
  cvDriveId             String?
  cvOriginalName        String?
  linkedinUrl           String?
  notes                 String?     @db.Text
  skills                String[]
  languages             String[]
  seniority             Seniority?
  yearsOfExperience     Int?
  currentCompensation   Float?
  currentCurrency       String?
  currentEmploymentType String?
  desiredCompensation   Float?
  minimumCompensation   Float?
  summary               String?     @db.Text
  strengths             String[]
  risks                 String[]
  sourcedByType         SourceType?
  sourcedByUserId       String?
  sourcedByVendorId     String?
  sourcedByOther        String?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  deletedAt             DateTime?

  candidatePositions CandidatePosition[]
  sourcedByUser      User?               @relation("CandidateSourcedByUser", fields: [sourcedByUserId], references: [id])
  sourcedByVendor    Vendor?             @relation(fields: [sourcedByVendorId], references: [id])
  emailLogs          EmailLog[]
}

model CandidatePosition {
  id                  String            @id @default(cuid())
  candidateId         String
  positionId          String
  stage                 Stage             @default(APPLIED)
  stageEnteredAt        DateTime          @default(now())
  fitScore              Float?
  technicalFitScore     Float?
  seniorityFitScore     Float?
  domainFitScore        Float?
  communicationFitScore Float?
  fitSummary            String?           @db.Text
  fitStrengths          String[]
  fitGaps               String[]
  fitScoredAt           DateTime?
  noticePeriodDays      Int?
  earliestStartDate     DateTime?
  compensationRisk      CompensationRisk?
  notes                 String?           @db.Text
  recruiterId           String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  candidate    Candidate      @relation(fields: [candidateId], references: [id])
  position     Position       @relation(fields: [positionId], references: [id])
  recruiter    User           @relation("RecruiterCandidatePositions", fields: [recruiterId], references: [id])
  stageHistory StageHistory[]
  interviews   Interview[]
  emailLogs    EmailLog[]

  @@unique([candidateId, positionId])
}

model StageHistory {
  id                  String   @id @default(cuid())
  candidatePositionId String
  fromStage           Stage?
  toStage             Stage
  movedAt             DateTime @default(now())
  movedById           String
  notes               String?  @db.Text

  candidatePosition CandidatePosition @relation(fields: [candidatePositionId], references: [id])
  movedBy           User              @relation(fields: [movedById], references: [id])
}

model Interview {
  id                  String            @id @default(cuid())
  candidatePositionId String
  stage               PipelineStage
  roundLabel          String
  roundNumber         Int
  isInternal          Boolean           @default(true)
  status              InterviewStatus   @default(PENDING)
  schedulingMode      SchedulingMode?
  proposedSlots       DateTime[]
  calendarLinkUsed    String?
  scheduledAt         DateTime?
  feedbackText        String?           @db.Text
  feedbackPdfUrl      String?
  feedbackSummary     String?           @db.Text
  feedbackStrengths   String[]
  feedbackConcerns    String[]
  aiRecommendedDecision InterviewDecision?
  feedbackParseMethod String?
  durationMinutes     Int?
  decision            InterviewDecision?
  decisionNotes       String?           @db.Text
  decidedAt           DateTime?
  decidedById         String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  candidatePosition CandidatePosition @relation(fields: [candidatePositionId], references: [id])
  decidedBy         User?             @relation("InterviewDecidedBy", fields: [decidedById], references: [id])
  emailLogs         EmailLog[]
}

model EmailLog {
  id          String   @id @default(cuid())
  to          String
  subject     String
  template    String
  status      String
  errorMsg    String?
  sentAt      DateTime @default(now())

  candidateId         String?
  candidatePositionId String?
  interviewId         String?
  sentById            String?

  candidate         Candidate?         @relation(fields: [candidateId], references: [id])
  candidatePosition CandidatePosition? @relation(fields: [candidatePositionId], references: [id])
  interview         Interview?         @relation(fields: [interviewId], references: [id])
  sentBy            User?              @relation(fields: [sentById], references: [id])
}

model SystemSettings {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}
